<?xml version="1.0"?>
<robot name="alpha_robot">
  <!-- Add world link -->
  <link name="world"/>

  <!-- Material definition -->
  <material name="alpha_black">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="meshes/RS1-1010.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.150" radius="0.020"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="-0.055 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  
  <!-- Fixed joint from world to base -->
  <joint name="base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- M3 Inline link -->
  <link name="m3_inline_link">
    <visual>
      <geometry>
        <mesh filename="meshes/M3-INLINE.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.150" radius="0.020"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="-0.055 0 0"/>
    </collision>
    <inertial>
      <mass value="0.341"/>
      <origin xyz="-0.055 0 0"/>
      <inertia ixx="0.0000682" ixy="0" ixz="0" iyy="0.000673" iyz="0" izz="0.000673"/>
    </inertial>
  </link>
  
  <!-- Mount joint -->
  <joint name="mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="m3_inline_link"/>
    <origin xyz="0.124 0.004 0" rpy="0 0 0"/>
  </joint>

  <!-- M2-1-1 link -->
  <link name="m2_1_1_link">
    <visual>
      <geometry>
        <mesh filename="meshes/M2-1-1.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.033" radius="0.020"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.0165"/>
    </collision>
    <inertial>
      <mass value="0.194"/>
      <origin xyz="0 0 0.0165"/>
      <inertia ixx="0.000037" ixy="0" ixz="0" iyy="0.000037" iyz="0" izz="0.0000388"/>
    </inertial>
  </link>
  
  <!-- Joint 1 (axis_e) - Base Joint: 官方352°，软件限制，对称±176° -->
  <joint name="joint_1" type="revolute">
    <parent link="m3_inline_link"/>
    <child link="m2_1_1_link"/>
    <origin xyz="0 0 0.014"/>
    <axis xyz="0 0 1"/>
    <limit effort="9.0" lower="-3.072" upper="3.072" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- M2 link -->
  <link name="m2_link">
    <visual>
      <geometry>
        <mesh filename="meshes/M2.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.145" radius="0.020"/>
      </geometry>
      <origin rpy="0 0 0" xyz="-0.02 0 -0.0725"/>
    </collision>
    <collision>
      <geometry>
        <cylinder length="0.040" radius="0.020"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
    </collision>
    <collision>
      <geometry>
        <cylinder length="0.040" radius="0.020"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="-0.040 0 -0.1453"/>
    </collision>
    <inertial>
      <mass value="0.429"/>
      <origin xyz="-0.02 0 -0.0725"/>
      <inertia ixx="0.0008907" ixy="0" ixz="0" iyy="0.0008907" iyz="0" izz="0.0000858"/>
    </inertial>
  </link>
  
  <!-- Joint 2 (axis_d) - Shoulder Joint: 官方200°，对称±100° -->
  <!-- 
  根据官方规格，关节总范围是200度(±100度)
  保持原有的rpy偏移来修正mesh姿态，但使用官方对称限制
  这样零位置在安全范围中心，正负范围相等
  -->
  <joint name="joint_2" type="revolute">
    <parent link="m2_1_1_link"/>
    <child link="m2_link"/>
    <origin xyz="-0.02 0 0.033" rpy="0 1.745 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="9.0" lower="-1.745" upper="1.745" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- M2-1-3 link -->
  <link name="m2_1_3_link">
    <visual>
      <geometry>
        <mesh filename="meshes/M2-1-3.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.033" radius="0.020"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.02 0 0.0165"/>
    </collision>
    <inertial>
      <mass value="0.115"/>
      <origin xyz="0.02 0 0.0165"/>
      <inertia ixx="0.0000219" ixy="0" ixz="0" iyy="0.0000219" iyz="0" izz="0.000023"/>
    </inertial>
  </link>
  
  <!-- Joint 3 (axis_c) - Elbow Joint: 官方185°，对称±92.5° -->
  <!-- 
  根据官方规格调整为1.614弧度(±92.5度)
  保持原有的rpy偏移来修正mesh姿态
  -->
  <joint name="joint_3" type="revolute">
    <parent link="m2_link"/>
    <child link="m2_1_3_link"/>
    <origin xyz="-0.04 0 -0.1453" rpy="0 0.204 3.14159"/>
    <axis xyz="0 1 0"/>
    <limit effort="9.0" lower="-1.614" upper="1.614" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- M1 link -->
  <link name="m1_link">
    <visual>
      <geometry>
        <mesh filename="meshes/M1.dae"/>
      </geometry>
      <origin rpy="0 -1.5707 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.020"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
    </collision>
    <inertial>
      <mass value="0.200"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.0001867" ixy="0" ixz="0" iyy="0.0001867" iyz="0" izz="0.00004"/>
    </inertial>
  </link>
  
  <!-- Joint 4 (axis_b) - Wrist Joint: 官方90°，对称±45° -->
  <!-- 
  官方规格确认为90度总范围，±45度
  保持原有的rpy偏移和限制，这是正确的
  -->
  <joint name="joint_4" type="revolute">
    <parent link="m2_1_3_link"/>
    <child link="m1_link"/>
    <origin xyz="0.02 0 0.033" rpy="0 0 2.09439"/>
    <axis xyz="0 0 -1"/>
    <limit effort="9.0" lower="-0.785" upper="0.785" velocity="0.5"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- RS1-124 link -->
  <link name="rs1_124_link">
    <visual>
      <geometry>
        <mesh filename="meshes/RS1-124.dae"/>
      </geometry>
      <origin rpy="0 -1.5707 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.020"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <!-- TCP base joint -->
  <joint name="tcp_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.09975"/>
    <parent link="m1_link"/>
    <child link="rs1_124_link"/>
  </joint>

  <!-- Push rod -->
  <link name="push_rod">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <material name="alpha_black"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <!-- Joint 5 (axis_a) - End-effector: 直线运动，保持原设计 -->
  <!-- 
  这是直线运动关节，不是旋转关节
  官方数据中的328度应该是指末端夹爪的旋转范围，不是这个关节
  保持原有的直线运动设计
  -->
  <joint name="joint_5" type="prismatic">
    <origin rpy="0 0 0" xyz="0 0 0.009"/>
    <parent link="rs1_124_link"/>
    <child link="push_rod"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" lower="0.001" upper="0.013" velocity="10"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

</robot>