<?xml version="1.0"?>
<robot name="alpha_robot">
  <!-- Add world link -->
  <link name="world"/>

  <!-- Material definition -->
  <material name="alpha_black">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="meshes/RS1-1010.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.150" radius="0.03"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="-0.055 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  
  <!-- Fixed joint from world to base -->
  <joint name="base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- M3 Inline link -->
  <link name="m3_inline_link">
    <visual>
      <geometry>
        <mesh filename="meshes/M3-INLINE.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.150" radius="0.03"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="-0.055 0 0"/>
    </collision>
    <inertial>
      <mass value="0.341"/>
      <origin xyz="-0.055 0 0"/>
      <inertia ixx="0.0000682" ixy="0" ixz="0" iyy="0.000673" iyz="0" izz="0.000673"/>
    </inertial>
  </link>
  
  <!-- Mount joint -->
  <joint name="mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="m3_inline_link"/>
    <origin xyz="0.124 0.004 0" rpy="0 0 0"/>
  </joint>

  <!-- M2-1-1 link -->
  <link name="m2_1_1_link">
    <visual>
      <geometry>
        <mesh filename="meshes/M2-1-1.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.033" radius="0.03"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.0165"/>
    </collision>
    <inertial>
      <mass value="0.194"/>
      <origin xyz="0 0 0.0165"/>
      <inertia ixx="0.000037" ixy="0" ixz="0" iyy="0.000037" iyz="0" izz="0.0000388"/>
    </inertial>
  </link>
  
  <!-- Joint 1 (axis_e) - Base Joint -->
  <joint name="joint_1" type="revolute">
    <parent link="m3_inline_link"/>
    <child link="m2_1_1_link"/>
    <origin xyz="0 0 0.014"/>
    <axis xyz="0 0 1"/>
    <limit effort="9.0" lower="0" upper="5.725" velocity="0.785"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- M2 link -->
  <link name="m2_link">
    <visual>
      <geometry>
        <mesh filename="meshes/M2.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.145" radius="0.03"/>
      </geometry>
      <origin rpy="0 0 0" xyz="-0.02 0 -0.0725"/>
    </collision>

    <collision>
      <geometry>
        <cylinder length="0.040" radius="0.03"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
    </collision>

    <collision>
      <geometry>
        <cylinder length="0.040" radius="0.03"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="-0.040 0 -0.1453"/>
    </collision>
    <!-- 顶部球体 -->
    <collision>
      <geometry>
        <sphere radius="0.032"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </collision>

    <!-- 底部球体 -->
    <collision>
      <geometry>
        <sphere radius="0.032"/>
      </geometry>
      <origin xyz="-0.040 0 -0.1453"/>
    </collision>
    <inertial>
      <mass value="0.429"/>
      <origin xyz="-0.02 0 -0.0725"/>
      <inertia ixx="0.0008907" ixy="0" ixz="0" iyy="0.0008907" iyz="0" izz="0.0000858"/>
    </inertial>
  </link>
  
  <!-- Joint 2 (axis_d) - Shoulder Joint -->
  <joint name="joint_2" type="revolute">
    <parent link="m2_1_1_link"/>
    <child link="m2_link"/>
    <origin xyz="-0.02 0 0.033" rpy="0 1.745 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="9.0" lower="-1.745" upper="1.745" velocity="0.698"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- M2-1-3 link -->
  <link name="m2_1_3_link">
    <visual>
      <geometry>
        <mesh filename="meshes/M2-1-3.dae"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.033" radius="0.03"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.02 0 0.0165"/>
    </collision>
    <inertial>
      <mass value="0.115"/>
      <origin xyz="0.02 0 0.0165"/>
      <inertia ixx="0.0000219" ixy="0" ixz="0" iyy="0.0000219" iyz="0" izz="0.000023"/>
    </inertial>
  </link>
  
  <!-- Joint 3 (axis_c) - Elbow Joint -->
  <joint name="joint_3" type="revolute">
    <parent link="m2_link"/>
    <child link="m2_1_3_link"/>
    <origin xyz="-0.04 0 -0.1453" rpy="0 0.204 3.14159"/>
    <axis xyz="0 1 0"/>
    <limit effort="9.0" lower="0" upper="3.228" velocity="0.698"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- M1 link -->
  <link name="m1_link">
    <visual>
      <geometry>
        <mesh filename="meshes/M1.dae"/>
      </geometry>
      <origin rpy="0 -1.5707 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.03"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
    </collision>
    <inertial>
      <mass value="0.200"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.0001867" ixy="0" ixz="0" iyy="0.0001867" iyz="0" izz="0.00004"/>
    </inertial>
  </link>
  
  <!-- Joint 4 (axis_b) - Wrist Joint -->
  <joint name="joint_4" type="revolute">
    <parent link="m2_1_3_link"/>
    <child link="m1_link"/>
    <origin xyz="0.02 0 0.033" rpy="0 0 2.09439"/>
    <axis xyz="0 0 -1"/>
    <limit effort="9.0" lower="0" upper="5.725" velocity="1.047"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- End effector base link -->
  <link name="ee_base_link">
    <!-- <collision>
      <geometry>
        <cylinder length="0.01" radius="0.01"/>
      </geometry>
      <origin xyz="0 0 0.006"/>
    </collision> -->
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.005"/>
      <inertia ixx="5e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="5e-5"/>
    </inertial>
  </link>
  
  <joint name="ee_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.09975"/>
    <parent link="m1_link"/>
    <child link="ee_base_link"/>
  </joint>

  <!-- Push rod -->
  <link name="push_rod">
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0.0075"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  
  <!-- Joint 5 (axis_a) - Prismatic joint for gripper control -->
  <joint name="joint_5" type="prismatic">
    <origin rpy="0 0 0" xyz="0 0 0.009"/>
    <parent link="ee_base_link"/>
    <child link="push_rod"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" lower="0.00137" upper="0.0133" velocity="0.003"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Standard gripper base (RS1-124) -->
  <link name="standard_jaws_base_link">
    <visual>
      <geometry>
        <mesh filename="meshes/end_effectors/RS1-124.stl"/>
      </geometry>
      <origin rpy="0 -1.5707 0" xyz="0 0 0"/>
      <material name="alpha_black"/>
    </visual>
    <inertial>
      <mass value="0.03"/>
      <origin xyz="0 0 0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  
  <joint name="standard_jaws_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="ee_base_link"/>
    <child link="standard_jaws_base_link"/>
  </joint>

  <!-- Gripper finger RS1-130 -->
  <link name="standard_jaws_rs1_130_link">
    <visual>
      <geometry>
        <mesh filename="meshes/end_effectors/RS1-130.dae"/>
      </geometry>
      <material name="alpha_black"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.012 0.03 0.09"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.0 -0.008 0.045"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 -0.008 0.045"/>
      <inertia ixx="2e-5" ixy="0" ixz="0" iyy="2e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  
  <joint name="standard_jaws_rs1_130_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0.0155 0.0069"/>
    <parent link="standard_jaws_base_link"/>
    <child link="standard_jaws_rs1_130_link"/>
    <axis xyz="-1 0 0"/>
    <limit effort="10" lower="0" upper="0.5" velocity="10"/>
    <dynamics damping="0.1" friction="0.05"/>
    <mimic joint="joint_5" multiplier="41.67" offset="0"/>
  </joint>

  <!-- Gripper finger RS1-139 -->
  <link name="standard_jaws_rs1_139_link">
    <visual>
      <geometry>
        <mesh filename="meshes//end_effectors/RS1-139.dae"/>
      </geometry>
      <material name="alpha_black"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.012 0.03 0.09"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.0 0.008 0.045"/>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0.008 0.045"/>
      <inertia ixx="2e-5" ixy="0" ixz="0" iyy="2e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  
  <joint name="standard_jaws_rs1_139_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 -0.0155 0.0069"/>
    <parent link="standard_jaws_base_link"/>
    <child link="standard_jaws_rs1_139_link"/>
    <axis xyz="1 0 0"/>
    <limit effort="10" lower="0" upper="0.5" velocity="10"/>
    <dynamics damping="0.1" friction="0.05"/>
    <mimic joint="standard_jaws_rs1_130_joint" multiplier="1" offset="0"/>
  </joint>

  <!-- Tool Center Point (TCP) -->
  <link name="tcp">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  
  <joint name="tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.09"/>
    <parent link="standard_jaws_base_link"/>
    <child link="tcp"/>
  </joint>

</robot>
